@using MocBakery.Models.Entities
@using MocBakery.Models.DTOs.Accounts
@{
    var employee=(UserSession)ViewData["AdminEmployee"]!;
    bool owner=employee.VaiTro==Roles.ChuTiem,sales=Roles.CanSell(employee.VaiTro);
    string? Current(string path)=>Context.Request.Path==path||(path!="/admin"&&Context.Request.Path.StartsWithSegments(path))?"page":null;
}
<!DOCTYPE html><html lang="vi"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>@ViewData["Title"] · quản trị Mộc Bakery</title><link rel="stylesheet" href="~/css/admin.css" asp-append-version="true"/></head>
<body><a class="admin-skip" href="#admin-content">Đến nội dung chính</a><div class="admin-shell">
<aside class="admin-sidebar" id="admin-navigation"><a class="admin-brand" href="/admin">MỘC <span>BAKERY / QUẢN TRỊ</span></a><p class="nav-caption">KHÔNG GIAN LÀM VIỆC</p>
<nav aria-label="Quản trị"><a admin-icon="home" href="/admin" aria-current="@Current("/admin")">Tổng quan</a>
@if(sales){<a admin-icon="orders" href="/admin/don-hang" aria-current="@Current("/admin/don-hang")">Đơn hàng</a>}
<a admin-icon="cake" href="/admin/banh" aria-current="@Current("/admin/banh")">Quản lý bánh</a><a admin-icon="layers" href="/admin/danh-muc" aria-current="@Current("/admin/danh-muc")">Danh mục bánh</a><a admin-icon="box" href="/admin/kho" aria-current="@Current("/admin/kho")">Kho bánh</a>
<a admin-icon="calendar" href="/admin/ton-kho" aria-current="@Current("/admin/ton-kho")">Tồn kho và hạn dùng</a><a admin-icon="receipt" href="/admin/phieu-nhap" aria-current="@Current("/admin/phieu-nhap")">Phiếu nhập kho</a><a admin-icon="truck" href="/admin/nha-cung-cap" aria-current="@Current("/admin/nha-cung-cap")">Nhà cung cấp</a><a admin-icon="leaf" href="/admin/nguyen-lieu" aria-current="@Current("/admin/nguyen-lieu")">Nguyên liệu</a>
@if(sales){<a admin-icon="users" href="/admin/khach-hang" aria-current="@Current("/admin/khach-hang")">Khách hàng</a><a admin-icon="receipt" href="/admin/hoa-don" aria-current="@Current("/admin/hoa-don")">Hóa đơn</a>}
@if(owner){<a admin-icon="user" href="/admin/nhan-vien" aria-current="@Current("/admin/nhan-vien")">Nhân viên</a><a admin-icon="shield" href="/admin/tai-khoan" aria-current="@Current("/admin/tai-khoan")">Tài khoản nhân viên</a><a admin-icon="chart" href="/admin/bao-cao" aria-current="@Current("/admin/bao-cao")">Báo cáo doanh thu</a>}
</nav><div class="sidebar-bottom"><a admin-icon="store" href="/" target="_blank" rel="noopener">Xem cửa hàng ↗</a><a admin-icon="key" href="/admin/doi-mat-khau">Đổi mật khẩu</a><form action="/admin/dang-xuat" method="post" asp-antiforgery="true"><button admin-icon="logout" type="submit">Đăng xuất quản trị</button></form></div></aside>
<div class="admin-main"><header class="admin-topbar">
<button class="admin-menu-toggle" type="button" aria-controls="admin-navigation" aria-expanded="false" aria-label="Mở menu quản trị"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button>
<div class="admin-location"><span class="admin-eyebrow">MỘC BAKERY <span aria-hidden="true">/</span> QUẢN TRỊ</span><p>@ViewData["Title"]</p></div>
<div class="employee-badge"><span class="employee-avatar" aria-hidden="true">@System.Globalization.StringInfo.GetNextTextElement(employee.HoTen.Trim())</span><div><span>@employee.HoTen</span><small>@Roles.Display(employee.VaiTro)</small></div></div></header>
<main id="admin-content" class="admin-content">
@if(new[]{"Products","Categories","Inventory","Orders","Customers","Staff","Accounts","Invoices","Reports","Suppliers","Materials","Receipts","Stock"}.Contains(ViewContext.RouteData.Values["action"]?.ToString())){<p><a href="/admin">← Về tổng quan</a></p>}
@if(TempData["AdminSuccess"] is string success){<p class="notice success" role="status">@success</p>}
@if(TempData["AdminError"] is string error){<p class="notice error" role="alert">@error</p>}
@RenderBody()</main><footer class="admin-footer">Mộc Bakery · Khu vực dành cho nhân viên được phân quyền</footer></div></div><script src="~/js/admin-shell.js" asp-append-version="true" defer></script></body></html>
