@using MocBakery.Models.Entities
@using MocBakery.Models.DTOs.Accounts
@{
    var employee=(UserSession)ViewData["AdminEmployee"]!;
    bool owner=employee.VaiTro==Roles.ChuTiem,sales=Roles.CanSell(employee.VaiTro);
    string? Current(string path)=>Context.Request.Path==path||(path!="/admin"&&Context.Request.Path.StartsWithSegments(path))?"page":null;
}
<!DOCTYPE html><html lang="vi"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>@ViewData["Title"] · quản trị Mộc Bakery</title><link rel="stylesheet" href="~/css/admin.css" asp-append-version="true"/></head>
<body><a class="admin-skip" href="#admin-content">Đến nội dung chính</a><div class="admin-shell">
<aside class="admin-sidebar"><a class="admin-brand" href="/admin">MỘC <span>BAKERY / QUẢN TRỊ</span></a><p class="nav-caption">KHÔNG GIAN LÀM VIỆC</p>
<nav aria-label="Quản trị"><a href="/admin" aria-current="@Current("/admin")">Tổng quan</a>
@if(sales){<a href="/admin/don-hang" aria-current="@Current("/admin/don-hang")">Đơn hàng</a>}
<a href="/admin/banh" aria-current="@Current("/admin/banh")">Quản lý bánh</a><a href="/admin/danh-muc" aria-current="@Current("/admin/danh-muc")">Danh mục bánh</a><a href="/admin/kho" aria-current="@Current("/admin/kho")">Kho bánh</a>
@if(sales){<a href="/admin/khach-hang" aria-current="@Current("/admin/khach-hang")">Khách hàng</a><a href="/admin/hoa-don" aria-current="@Current("/admin/hoa-don")">Hóa đơn</a>}
@if(owner){<a href="/admin/nhan-vien" aria-current="@Current("/admin/nhan-vien")">Nhân viên</a><a href="/admin/tai-khoan" aria-current="@Current("/admin/tai-khoan")">Tài khoản nhân viên</a><a href="/admin/bao-cao" aria-current="@Current("/admin/bao-cao")">Báo cáo doanh thu</a>}
</nav><div class="sidebar-bottom"><a href="/" target="_blank" rel="noopener">Xem cửa hàng ↗</a><a href="/admin/doi-mat-khau">Đổi mật khẩu</a><form action="/admin/dang-xuat" method="post" asp-antiforgery="true"><button type="submit">Đăng xuất quản trị</button></form></div></aside>
<div class="admin-main"><header class="admin-topbar"><div><span class="admin-eyebrow">MỘC BAKERY</span><p>@ViewData["Title"]</p></div><div class="employee-badge"><span>@employee.HoTen</span><small>@Roles.Display(employee.VaiTro)</small></div></header>
<main id="admin-content" class="admin-content">
@if(new[]{"Products","Categories","Inventory","Orders","Customers","Staff","Accounts","Invoices","Reports"}.Contains(ViewContext.RouteData.Values["action"]?.ToString())){<p><a href="/admin">← Về tổng quan</a></p>}
@if(TempData["AdminSuccess"] is string success){<p class="notice success" role="status">@success</p>}
@if(TempData["AdminError"] is string error){<p class="notice error" role="alert">@error</p>}
@RenderBody()</main><footer class="admin-footer">Mộc Bakery · Khu vực dành cho nhân viên được phân quyền</footer></div></div></body></html>
