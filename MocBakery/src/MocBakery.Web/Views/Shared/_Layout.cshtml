<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Mộc Bakery</title>
    <link rel="stylesheet" href="~/css/accounts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip" href="#content">Đến nội dung chính</a>
    <header class="header maison-header">
        <div class="header-message">Đặt bánh trực tuyến <span aria-hidden="true">·</span> Nhận tại tiệm</div>
        <nav class="header-navigation" aria-label="Điều hướng chính">
            <div class="header-main">
                <a class="header-discover" href="/banh"><span>Khám phá</span><strong>Thực đơn của Mộc <span aria-hidden="true">↗</span></strong></a>
                <a class="brand maison-brand" href="/" aria-label="Mộc Bakery — trang chủ"><span class="brand-word">MỘC</span><span class="brand-tag">BAKERY &amp; PÂTISSERIE</span></a>
                <div class="header-tools">
                    <button class="header-tool" type="button" aria-label="Tìm kiếm bánh" aria-controls="header-search" aria-expanded="false" data-header-search><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4.5 4.5"/></svg><span class="tool-label">Tìm kiếm</span></button>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a class="header-tool" asp-controller="Account" asp-action="Index" aria-label="Tài khoản"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M4.5 21v-2a7.5 7.5 0 0 1 15 0v2"/></svg><span class="tool-label">Tài khoản</span></a>
                    }
                    else
                    {
                        <a class="header-tool" asp-controller="Account" asp-action="Login" aria-label="Đăng nhập"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M4.5 21v-2a7.5 7.5 0 0 1 15 0v2"/></svg><span class="tool-label">Đăng nhập</span></a>
                    }
                    <a class="header-tool header-cart" href="/gio-hang" aria-label="Giỏ hàng"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M5 7h14l1 14H4L5 7Z"/><path d="M8 8V6a4 4 0 0 1 8 0v2"/></svg><span class="tool-label">Giỏ hàng</span></a>
                    @if(User.Identity?.IsAuthenticated==true){<form asp-controller="Account" asp-action="Logout" method="post"><button class="header-tool" type="submit" aria-label="Đăng xuất"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M10 4H4v16h6M9 12h12m-4-4 4 4-4 4"/></svg><span class="tool-label">Đăng xuất</span></button></form>}
                </div>
            </div>
            <div class="header-menu">
                <a href="/" aria-current="@(Context.Request.Path=="/"?"page":null)">Trang chủ</a>
                <a href="/banh" aria-current="@(Context.Request.Path.StartsWithSegments("/banh")?"page":null)">Thực đơn bánh</a>
                <a href="/danh-muc" aria-current="@(Context.Request.Path.StartsWithSegments("/danh-muc")?"page":null)">Danh mục</a>
                @if(User.Identity?.IsAuthenticated==true){<a href="/don-hang" aria-current="@(Context.Request.Path.StartsWithSegments("/don-hang")?"page":null)">Đơn hàng</a>}
                else{<a asp-controller="Account" asp-action="Register">Đăng ký</a>}
            </div>
        </nav>
        <form id="header-search" class="header-search" action="/banh" method="get" role="search" aria-label="Tìm nhanh bánh" hidden>
            <label for="header-query">Bạn muốn tìm chiếc bánh nào?</label>
            <div><input id="header-query" name="q" type="search" maxlength="100" placeholder="Canelé, Croissant, Macaron…" autocomplete="off" required/><button class="store-button" type="submit">Xem kết quả <span aria-hidden="true">→</span></button><button class="header-search-close" type="button" aria-label="Đóng tìm kiếm" data-header-search-close>Đóng</button></div>
        </form>
    </header>
    <main id="content">@RenderBody()</main>
    <footer>MỘC BAKERY <span>·</span> Chọn bánh theo cách của bạn. <span>·</span> <a href="/admin/dang-nhap">Dành cho nhân viên</a></footer>
    <script src="~/js/site-header.js" asp-append-version="true" defer></script>
</body>
</html>
