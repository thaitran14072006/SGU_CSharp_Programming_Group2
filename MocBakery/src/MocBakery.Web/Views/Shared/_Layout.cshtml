<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Mộc Bakery</title>
    <link rel="stylesheet" href="~/css/accounts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip" href="#content">Đến nội dung chính</a>
    <header class="header">
        <a class="brand" href="/">MỘC <span>BAKERY</span></a>
        <nav aria-label="Điều hướng chính">
            <a href="/banh">Thực đơn bánh</a>
            <a href="/danh-muc">Danh mục</a>
            <a href="/gio-hang">Giỏ hàng</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a href="/don-hang">Đơn hàng</a>
                <a asp-controller="Account" asp-action="Index">Tài khoản</a>
                <form asp-controller="Account" asp-action="Logout" method="post"><button class="nav-button" type="submit">Đăng xuất</button></form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login">Đăng nhập</a>
                <a asp-controller="Account" asp-action="Register">Đăng ký</a>
            }
        </nav>
    </header>
    <main id="content">@RenderBody()</main>
    <footer>MỘC BAKERY <span>·</span> Chọn bánh theo cách của bạn. <span>·</span> <a href="/admin/dang-nhap">Dành cho nhân viên</a></footer>
</body>
</html>
