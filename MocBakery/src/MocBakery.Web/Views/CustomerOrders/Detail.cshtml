@model MocBakery.Models.WebOrders.CustomerOrderDetail
@{ViewData["Title"]="Chi tiết đơn #"+Model.Order.Id;}
<div class="store"><p class="eyebrow">MỘC BAKERY / ĐƠN HÀNG</p><h1>Đơn #@Model.Order.Id</h1>
@if(TempData["CartSuccess"] is string success){<p class="success" role="status">@success</p>}
<div class="cart-layout"><section><h2>Các bánh đã đặt</h2>
@foreach(var line in Model.Lines){<article class="cart-row"><div><h3>@line.Product</h3><p>@line.Quantity × @BakeryDisplay.Money(line.Price)</p></div><strong>@BakeryDisplay.Money(line.Total)</strong></article>}
<a href="/don-hang">← Đơn hàng của bạn</a></section>
<aside class="cart-summary"><h2>@Model.Order.StatusText</h2><p>Tổng tiền <strong>@BakeryDisplay.Money(Model.Order.Total)</strong></p><p>Đặt lúc @Model.Order.Placed.ToString("dd/MM/yyyy HH:mm")</p><p>Nhận tại tiệm @Model.Order.Pickup.ToString("dd/MM/yyyy HH:mm")</p>
@if(Model.Order.Note is not null){<p class="order-note">Yêu cầu: @Model.Order.Note</p>}
@if(Model.Order.CancelReason is not null){<p>Lý do hủy: @Model.Order.CancelReason</p>}
<p class="detail-note">Yêu cầu đã được ghi nhận. Bạn có thể xem trạng thái mới nhất tại đây. Việc gửi yêu cầu chưa thanh toán hoặc giữ kho.</p></aside></div></div>
