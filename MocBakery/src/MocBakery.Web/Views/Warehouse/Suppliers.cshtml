@model IReadOnlyList<Supplier>
@{ViewData["Title"]="Nhà cung cấp";bool manage=Roles.CanManageInventory(((UserSession)ViewData["AdminEmployee"]!).VaiTro);}
<div class="page-heading"><div><h1>Nhà cung cấp</h1><p>Thông tin và tình trạng hợp tác dùng chung với desktop.</p></div>@if(manage){<a class="btn primary" href="/admin/nha-cung-cap/them">+ Thêm nhà cung cấp</a>}</div>
<section class="panel"><div class="table-scroll"><table><thead><tr><th>Tên nhà cung cấp</th><th>Điện thoại</th><th>Email</th><th>Địa chỉ</th><th>Trạng thái</th>@if(manage){<th>Thao tác</th>}</tr></thead><tbody>@foreach(var s in Model){<tr><td>@s.Name</td><td>@s.Phone</td><td>@s.Email</td><td>@s.Address</td><td>@(s.Active?"Đang hợp tác":"Ngừng hợp tác")</td>@if(manage){<td><a class="btn small" href="/admin/nha-cung-cap/@s.Id/sua">Sửa</a></td>}</tr>}</tbody></table></div>@if(Model.Count==0){<p class="empty">Chưa có nhà cung cấp.</p>}</section>
