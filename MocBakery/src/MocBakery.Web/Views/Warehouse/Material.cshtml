@model MaterialForm
@{ViewData["Title"]=Model.Id==0?"Thêm nguyên liệu":"Sửa nguyên liệu";}
<div class="page-heading"><h1>@ViewData["Title"]</h1><a class="btn" href="/admin/nguyen-lieu">← Nguyên liệu</a></div>
<form asp-action="SaveMaterial" method="post" class="panel edit-panel"><div asp-validation-summary="All" class="validation" role="alert"></div><input asp-for="Id" type="hidden"/><label asp-for="Name">Tên nguyên liệu *</label><input asp-for="Name" maxlength="150" required/>
<div class="form-grid"><div><label asp-for="Unit">Đơn vị *</label><input asp-for="Unit" maxlength="20" required/></div><div><label asp-for="LowStock">Ngưỡng cảnh báo *</label><input asp-for="LowStock" type="number" min="0" max="1000000000" step="0.001" required/></div></div><label class="check"><input asp-for="Active"/> Đang sử dụng</label>
<div class="form-actions"><button class="btn primary" type="submit">Lưu nguyên liệu</button><a class="btn" href="/admin/nguyen-lieu">Hủy</a></div></form>
