@model IReadOnlyList<Material>
@{ViewData["Title"]="Nguyên liệu";bool manage=Roles.CanManageInventory(((UserSession)ViewData["AdminEmployee"]!).VaiTro);}
<div class="page-heading"><div><h1>Nguyên liệu</h1><p>Danh mục, đơn vị và ngưỡng cảnh báo tồn.</p></div>@if(manage){<a admin-icon="leaf" class="btn primary" href="/admin/nguyen-lieu/them">+ Thêm nguyên liệu</a>}</div>
<section class="panel"><div class="table-scroll"><table><thead><tr><th>Mã</th><th>Nguyên liệu</th><th>Đơn vị</th><th>Ngưỡng cảnh báo</th><th>Trạng thái</th>@if(manage){<th>Thao tác</th>}</tr></thead><tbody>@foreach(var m in Model){<tr><td>NL@(m.Id.ToString("000"))</td><td>@m.Name</td><td>@m.Unit</td><td>@m.LowStock.ToString("0.###")</td><td>@(m.Active?"Đang sử dụng":"Ngừng sử dụng")</td>@if(manage){<td><a admin-icon="edit" class="btn small" href="/admin/nguyen-lieu/@m.Id/sua">Sửa</a></td>}</tr>}</tbody></table></div>@if(Model.Count==0){<p class="empty">Chưa có nguyên liệu.</p>}</section>
