@model StockChangeForm
@{bool lotMode=Model.LotId>0;ViewData["Title"]=lotMode?"Kiểm kê lô":"Xuất kho";var items=(IReadOnlyList<WarehouseItem>)ViewData["StockItems"]!;var lot=ViewData["Lot"] as WarehouseRow;}
<div class="page-heading"><h1>@ViewData["Title"]</h1><a class="btn" href="/admin/ton-kho?kind=@Model.Kind">← Tồn kho</a></div>
<form asp-action="Change" method="post" class="panel edit-panel"><div asp-validation-summary="All" class="validation" role="alert"></div><input asp-for="Kind" type="hidden"/><input asp-for="LotId" type="hidden"/>
@if(lotMode){<input asp-for="ItemId" type="hidden"/><input name="Operation" value="KiemKe" type="hidden"/><h2>@lot?.Name · @lot?.Code</h2><p>Tồn hiện tại: @lot?.Remaining.ToString("0.###") @lot?.Unit. Nhập lượng thực đếm, hệ thống giữ nguyên lượng nhập gốc.</p>}
else{<input name="Operation" value="Xuat" type="hidden"/><label asp-for="ItemId">Mặt hàng *</label><select asp-for="ItemId" required><option value="">Chọn mặt hàng</option>@foreach(var item in items.Where(x=>x.Kind==Model.Kind)){<option value="@item.Id">@item.Code · @item.Name (@item.Unit)</option>}</select><label class="check"><input asp-for="Disposal"/> Hủy hàng hỏng hoặc hết hạn</label><p class="muted small">Xuất sử dụng chỉ lấy lô hợp lệ còn hạn, theo hạn gần nhất trước. Chọn hủy khi cần loại bỏ hàng hỏng, hết hạn hoặc đã ngừng bán.</p>}
<label asp-for="Quantity">@(lotMode?"Số lượng thực đếm *":"Số lượng xuất *")</label><input asp-for="Quantity" type="number" min="@(lotMode?"0":"0.001")" max="1000000000" step="@(Model.Kind==ItemKinds.Cake?"1":"0.001")" required/>
<label asp-for="Reason">Lý do *</label><textarea asp-for="Reason" maxlength="490" required></textarea><p class="muted small">Lệnh được ghi nhật ký với tài khoản đang đăng nhập, số cũ, số mới và lý do.</p>
<div class="form-actions"><button class="btn primary" type="submit">@(lotMode?"Lưu kiểm kê":"Ghi nhận xuất kho")</button><a class="btn" href="/admin/ton-kho?kind=@Model.Kind">Hủy và quay lại</a></div></form>
