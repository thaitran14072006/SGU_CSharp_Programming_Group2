@model ReceiptForm
@{ViewData["Title"]=Model.Id==0?"Lập phiếu nhập":"Phiếu PN"+Model.Id.ToString("000");var suppliers=(IReadOnlyList<Supplier>)ViewData["Suppliers"]!;var items=(IReadOnlyList<WarehouseItem>)ViewData["Items"]!;bool editable=Model.State=="Nhap"&&Roles.CanManageInventory(((UserSession)ViewData["AdminEmployee"]!).VaiTro);}
<div class="page-heading"><div><h1>@ViewData["Title"]</h1><p>@(Model.State=="Nhap"?"Nháp — chưa làm tăng tồn kho.":"Đã ghi sổ — phiếu được giữ nguyên để đối chiếu.")</p></div><a class="btn" href="/admin/phieu-nhap">← Phiếu nhập kho</a></div>
<form asp-action="SaveReceipt" method="post" class="panel receipt-editor" data-receipt><div asp-validation-summary="All" class="validation" role="alert"></div><input asp-for="Id" type="hidden"/><input asp-for="Version" type="hidden"/>
<fieldset disabled="@(!editable)"><div class="form-grid"><div><label asp-for="SupplierId">Nhà cung cấp *</label><select asp-for="SupplierId" required><option value="">Chọn nhà cung cấp</option>@foreach(var s in suppliers.Where(x=>x.Active||x.Id==Model.SupplierId)){<option value="@s.Id">@s.Name @(!s.Active?"(ngừng hợp tác)":"")</option>}</select></div><div><label asp-for="Date">Ngày nhập *</label><input asp-for="Date" type="date" required/></div></div>
<h2 class="receipt-lines-title">Các dòng hàng</h2><div data-lines>
@for(int i=0;i<Model.Lines.Count;i++){
<section class="receipt-line" data-line><div class="panel-heading"><h3>Dòng hàng <span data-line-number>@(i+1)</span></h3>@if(editable){<button class="btn small danger" type="button" data-remove-line>Bỏ dòng</button>}</div><div class="receipt-line-grid">
<div class="full-row"><label asp-for="Lines[i].Item">Mặt hàng *</label><select asp-for="Lines[i].Item" data-field="Item" required><option value="">Chọn bánh hoặc nguyên liệu</option>@foreach(var item in items.Where(x=>x.Active||x.Kind+":"+x.Id==Model.Lines[i].Item)){<option value="@(item.Kind+":"+item.Id)">@item.Code · @item.Name (@item.Unit) @(!item.Active?"— ngừng dùng":"")</option>}</select></div>
<div><label asp-for="Lines[i].LotCode">Số lô *</label><input asp-for="Lines[i].LotCode" data-field="LotCode" maxlength="50" required/></div><div><label asp-for="Lines[i].Quantity">Số lượng *</label><input asp-for="Lines[i].Quantity" data-field="Quantity" type="number" min="0.001" max="1000000000" step="0.001" required/></div>
<div><label asp-for="Lines[i].Produced">Ngày sản xuất *</label><input asp-for="Lines[i].Produced" data-field="Produced" type="date" required/></div><div><label asp-for="Lines[i].Expiry">Hạn sử dụng *</label><input asp-for="Lines[i].Expiry" data-field="Expiry" type="date" required/></div><div><label asp-for="Lines[i].Cost">Đơn giá nhập *</label><input asp-for="Lines[i].Cost" data-field="Cost" type="number" min="0" max="1000000000" step="0.01" required/></div><div><label>Thành tiền</label><output data-line-amount>@(Model.Lines[i].DisplayAmount is {} amount?BakeryDisplay.Money(amount):"—")</output></div>
</div></section>}
</div>@if(editable){<button class="btn" type="button" data-add-line>+ Thêm dòng hàng</button><noscript><p>Vui lòng bật JavaScript để thêm hoặc bỏ dòng hàng.</p></noscript>}</fieldset>
<p class="receipt-total">Tổng tiền: <strong data-receipt-total></strong><span class="receipt-server-total">@(Model.DisplayTotal is {} total?BakeryDisplay.Money(total):"—")</span></p>
@if(editable){<div class="form-actions"><button class="btn primary" type="submit">Lưu nháp</button><a class="btn" href="/admin/phieu-nhap">Hủy và quay lại</a></div>}
</form>
@if(editable&&Model.Id>0){<form asp-action="PostReceipt" asp-route-id="@Model.Id" method="post" class="panel"><h2>Ghi sổ phiếu nhập</h2><p>Ghi sổ theo bản nháp đã lưu, tạo lô và nhật ký kho. Hãy lưu mọi thay đổi trước khi tiếp tục.</p><button class="btn primary" type="submit" data-post-receipt>Ghi sổ phiếu đã lưu</button><p class="muted small" data-unsaved hidden>Biểu mẫu có thay đổi chưa lưu. Lưu nháp hoặc tải lại phiếu trước khi ghi sổ.</p></form>}
<script src="~/js/warehouse.js" asp-append-version="true" defer></script>
