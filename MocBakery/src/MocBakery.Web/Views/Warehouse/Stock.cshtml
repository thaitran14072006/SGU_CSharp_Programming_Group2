@model WarehouseStockPage
@{ViewData["Title"]="Tồn kho và hạn dùng";bool manage=Roles.CanManageInventory(((UserSession)ViewData["AdminEmployee"]!).VaiTro);}
<div class="page-heading"><div><h1>Tồn kho và hạn dùng</h1><p>Theo dõi từng lô bánh hoặc nguyên liệu, cảnh báo và lịch sử biến động.</p></div><a admin-icon="receipt" class="btn" href="/admin/phieu-nhap">Phiếu nhập kho →</a></div>
<form method="get" class="toolbar"><div><label for="kind">Loại hàng</label><select id="kind" name="kind"><option value="Banh" selected="@(Model.Kind==ItemKinds.Cake)">Bánh</option><option value="NguyenLieu" selected="@(Model.Kind==ItemKinds.Material)">Nguyên liệu</option></select></div><div><label for="q">Tên hoặc số lô</label><input id="q" name="q" type="search" value="@Model.Query"/></div><div><label for="filter">Cảnh báo</label><select id="filter" name="filter">@foreach(var (key,text) in new[]{("All","Tất cả"),("Low","Tồn thấp"),("Soon","Sắp hết hạn"),("Expired","Hết hạn"),("Stopped","Ngừng bán")}){<option value="@key" selected="@(Model.Filter==key)">@text</option>}</select></div><button admin-icon="filter" class="btn" type="submit">Lọc tồn kho</button></form>
@if(manage){<p><a admin-icon="box" class="btn primary" href="/admin/ton-kho/dieu-chinh?kind=@Model.Kind">Xuất kho theo FEFO</a></p>}
<section class="panel"><div class="table-scroll"><table><thead><tr><th>Số lô</th><th>Mặt hàng</th><th>Hạn sử dụng</th><th>Còn lại</th><th>Cảnh báo</th><th>Thao tác</th></tr></thead><tbody>@foreach(var row in Model.Rows){<tr><td>@row.Code</td><td>@row.Name</td><td>@row.Expiry.ToString("dd/MM/yyyy")</td><td>@row.Remaining.ToString("0.###") @row.Unit</td><td>@row.Warning</td><td><div class="actions"><a admin-icon="history" class="btn small" href="/admin/ton-kho/@row.Kind/@row.Id/lich-su">Nhật ký</a>@if(manage){<a admin-icon="stocktake" class="btn small" href="/admin/ton-kho/dieu-chinh?kind=@row.Kind&lotId=@row.Id">Kiểm kê lô</a>}</div></td></tr>}</tbody></table></div>@if(Model.Rows.Count==0){<p class="empty">Không có lô phù hợp bộ lọc.</p>}</section>
