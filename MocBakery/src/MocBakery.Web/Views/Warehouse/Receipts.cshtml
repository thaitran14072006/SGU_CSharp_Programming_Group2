@model IReadOnlyList<ReceiptSummary>
@{ViewData["Title"]="Phiếu nhập kho";bool manage=Roles.CanManageInventory(((UserSession)ViewData["AdminEmployee"]!).VaiTro);string state=ViewData["State"] as string??"";}
<div class="page-heading"><div><h1>Phiếu nhập kho</h1><p>Lưu nháp để kiểm tra, ghi sổ khi thực nhận hàng.</p></div>@if(manage){<a admin-icon="receipt" class="btn primary" href="/admin/phieu-nhap/them">+ Lập phiếu nhập</a>}</div>
<form method="get" class="toolbar"><div><label for="q">Mã phiếu hoặc nhà cung cấp</label><input id="q" name="q" type="search" value="@ViewData["Query"]"/></div><div><label for="state">Trạng thái phiếu</label><select id="state" name="state"><option value="">Tất cả</option><option value="Nhap" selected="@(state=="Nhap")">Nháp</option><option value="DaGhiSo" selected="@(state=="DaGhiSo")">Đã ghi sổ</option></select></div><button admin-icon="search" class="btn" type="submit">Tìm phiếu</button></form>
<section class="panel"><div class="table-scroll"><table><thead><tr><th>Phiếu</th><th>Nhà cung cấp</th><th>Ngày nhập</th><th>Tổng tiền</th><th>Trạng thái</th></tr></thead><tbody>@foreach(var r in Model){<tr><td><a href="/admin/phieu-nhap/@r.Id">@r.Code</a></td><td>@r.Supplier</td><td>@r.Date.ToString("dd/MM/yyyy")</td><td>@BakeryDisplay.Money(r.Total)</td><td><span class="status @(r.State=="Nhap"?"":"active")">@r.Status</span></td></tr>}</tbody></table></div>@if(Model.Count==0){<p class="empty">Không có phiếu phù hợp.</p>}</section>
