@model IReadOnlyList<LoaiBanh>
@{ViewData["Title"]="Danh mục bánh";bool owner=((UserSession)ViewData["AdminEmployee"]!).VaiTro==Roles.ChuTiem;}
<div class="page-heading"><div><h1>Danh mục bánh</h1><p>Nhóm các loại bánh để khách dễ lựa chọn.</p></div>@if(owner){<a admin-icon="layers" class="btn primary" href="/admin/danh-muc/them">+ Thêm danh mục</a>}</div>
<section class="panel"><div class="table-scroll"><table><thead><tr><th>Mã</th><th>Tên danh mục</th><th>Trạng thái</th>@if(owner){<th>Thao tác</th>}</tr></thead><tbody>@foreach(var c in Model){<tr><td>DM@(c.MaLoai.ToString("000"))</td><td><strong>@c.TenLoai</strong><br/><small class="muted">@c.MoTa</small></td><td><span class="status @(c.DangSuDung?"active":"inactive")">@(c.DangSuDung?"Đang dùng":"Ngừng dùng")</span></td>@if(owner){<td><div class="actions"><a admin-icon="edit" class="btn small" href="/admin/danh-muc/@c.MaLoai/sua">Sửa</a><form data-confirm-title="Xóa danh mục @c.TenLoai?" data-confirm-message="Danh mục sẽ bị xóa vĩnh viễn nếu chưa có bánh sử dụng. Danh mục đang được sử dụng sẽ được giữ lại." data-confirm-label="Xóa danh mục" data-confirm-danger="true" action="/admin/danh-muc/@c.MaLoai/xoa" method="post" asp-antiforgery="true"><button admin-icon="trash" class="btn small danger" type="submit">Xóa nếu chưa dùng</button></form></div></td>}</tr>}</tbody></table></div>@if(Model.Count==0){<p class="empty">Chưa có danh mục.</p>}</section>
