@model IReadOnlyList<MocBakery.Models.DTOs.Customers.InvoiceSummary>
@{ViewData["Title"]="Hóa đơn";}
<div class="page-heading"><div><h1>Hóa đơn</h1><p>Các giao dịch đã được lập tại cửa hàng và khi giao đơn.</p></div></div>
<section class="panel"><div class="table-scroll"><table><thead><tr><th>Mã hóa đơn</th><th>Ngày lập</th><th>Khách hàng</th><th>Tổng tiền</th><th>Cọc đã trừ</th><th>Đã thu</th></tr></thead><tbody>@foreach(var h in Model){<tr><td><a href="/admin/hoa-don/@h.MaHoaDon">#@h.MaHoaDon</a></td><td>@h.NgayLap.ToString("dd/MM/yyyy HH:mm")</td><td>@h.CustomerName</td><td>@BakeryDisplay.Money(h.TongTien)</td><td>@BakeryDisplay.Money(h.TienCocTru)</td><td>@BakeryDisplay.Money(h.SoTienThu)</td></tr>}</tbody></table></div>@if(Model.Count==0){<p class="empty">Chưa có hóa đơn.</p>}</section>
