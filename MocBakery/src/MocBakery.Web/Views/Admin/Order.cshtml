@model AdminOrderDetail
@{ViewData["Title"]="Đơn #"+Model.Order.Id;var o=Model.Order;}
<div class="page-heading"><div><h1>Đơn #@o.Id</h1><p>Đặt lúc @o.Placed.ToString("dd/MM/yyyy HH:mm") · <span class="status @o.Status">@AdminDisplay.Status(o.Status)</span></p></div><a class="btn" href="/admin/don-hang">← Danh sách đơn</a></div>
<div class="order-grid"><section class="panel"><h2>Chi tiết bánh</h2><div class="table-scroll"><table><thead><tr><th>Bánh</th><th>Số lượng</th><th>Đơn giá</th><th>Thành tiền</th></tr></thead><tbody>@foreach(var line in Model.Lines){<tr><td>@line.Product</td><td>@line.Quantity</td><td>@BakeryDisplay.Money(line.Price)</td><td>@BakeryDisplay.Money(line.Total)</td></tr>}</tbody></table></div><dl class="info-list"><dt>Tổng tiền</dt><dd><strong>@BakeryDisplay.Money(o.Total)</strong></dd><dt>Tiền cọc</dt><dd>@BakeryDisplay.Money(o.Deposit)</dd><dt>Còn thu khi giao</dt><dd>@BakeryDisplay.Money(o.Due)</dd></dl></section>
<section class="panel"><h2>Thông tin nhận bánh</h2><dl class="info-list"><dt>Người nhận</dt><dd>@(o.Contact?.FullName??o.Customer)</dd><dt>Số điện thoại</dt><dd>@(o.Contact?.Phone??"Chưa có thông tin nhận riêng")</dd>@if(o.Contact is {} contact){<dt>Email</dt><dd>@contact.Email</dd>}<dt>Giờ nhận</dt><dd>@o.Pickup.ToString("dd/MM/yyyy HH:mm")</dd><dt>Tài khoản xử lý</dt><dd>@o.Receiver</dd><dt>Yêu cầu</dt><dd>@(o.Note??"Không có yêu cầu thêm")</dd>@if(o.CancelReason is not null){<dt>Lý do hủy</dt><dd>@o.CancelReason</dd>}</dl>
@if(o.Status=="MoiTiepNhan"){<form action="/admin/don-hang/@o.Id/tiep-nhan" method="post" asp-antiforgery="true"><button class="btn primary full" type="submit">Tiếp nhận và chuẩn bị</button></form>}
@if(o.Status=="DangChuanBi"){<form action="/admin/don-hang/@o.Id/giao" method="post" asp-antiforgery="true"><p class="muted small">Chỉ giao khi khách nhận bánh. Thao tác này lập hóa đơn và trừ kho.</p><button class="btn primary full" type="submit">Giao đơn và lập hóa đơn</button></form>}
@if(o.Status is "MoiTiepNhan" or "DangChuanBi"){<form action="/admin/don-hang/@o.Id/huy" method="post" asp-antiforgery="true"><label for="reason">Lý do hủy</label><textarea id="reason" name="reason" maxlength="255" required></textarea><button class="btn danger" type="submit">Hủy đơn</button></form>}</section></div>
