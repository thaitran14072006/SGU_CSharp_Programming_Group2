@model AdminCustomerForm
@{ViewData["Title"]=Model.Id==0?"Thêm khách hàng":"Sửa khách hàng";}
<div class="page-heading"><h1>@ViewData["Title"]</h1><a class="btn" href="/admin/khach-hang">← Khách hàng</a></div>
<form action="/admin/khach-hang/luu" method="post" asp-antiforgery="true" class="panel edit-panel"><div asp-validation-summary="All" class="validation" role="alert"></div><input asp-for="Id" type="hidden"/><div class="form-grid"><div><label asp-for="FullName">Họ tên *</label><input asp-for="FullName" maxlength="100" required/></div><div><label asp-for="Phone">Số điện thoại *</label><input asp-for="Phone" type="tel" inputmode="numeric" pattern="[0-9]{10}" maxlength="10" required/></div><div class="full-row"><label asp-for="Address">Địa chỉ</label><input asp-for="Address" maxlength="255"/></div><div class="full-row"><label asp-for="Note">Ghi chú nội bộ</label><textarea asp-for="Note" maxlength="255"></textarea><p class="muted small">Chỉ nhân viên có quyền quản lý khách hàng xem được ghi chú này.</p></div></div><div class="form-actions"><button admin-icon="save" class="btn primary" type="submit">Lưu hồ sơ</button><a admin-icon="close" class="btn" href="/admin/khach-hang">Hủy</a></div></form>
