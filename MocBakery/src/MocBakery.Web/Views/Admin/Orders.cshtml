@model IReadOnlyList<OrderSummary>
@{ViewData["Title"]="Quản lý đơn hàng";string selected=ViewData["Status"] as string??"";}
<div class="page-heading"><div><h1>Đơn hàng</h1><p>Tiếp nhận, chuẩn bị và theo dõi đơn từ cửa hàng và khách đặt Web.</p></div></div>
<form method="get" class="toolbar"><div><label for="status">Lọc trạng thái</label><select id="status" name="status"><option value="">Tất cả đơn</option>@foreach(var status in new[]{"MoiTiepNhan","DangChuanBi","DaGiao","DaHuy"}){<option value="@status" selected="@(selected==status)">@AdminDisplay.Status(status)</option>}</select></div><button class="btn" type="submit">Lọc đơn</button></form>
<section class="panel"><div class="table-scroll"><table><thead><tr><th>Mã đơn</th><th>Người nhận</th><th>Nhận tại tiệm</th><th>Tổng tiền</th><th>Trạng thái</th><th>Tiếp nhận</th></tr></thead><tbody>@foreach(var o in Model){<tr><td><a href="/admin/don-hang/@o.Id">#@o.Id</a></td><td><strong>@(o.Contact?.FullName??o.Customer)</strong><br/><small class="muted">@o.Contact?.Phone</small></td><td>@o.Pickup.ToString("dd/MM/yyyy HH:mm")</td><td class="nowrap">@BakeryDisplay.Money(o.Total)</td><td><span class="status @o.Status">@AdminDisplay.Status(o.Status)</span></td><td>@o.Receiver</td></tr>}</tbody></table></div>@if(Model.Count==0){<p class="empty">Không có đơn phù hợp.</p>}</section>
