@model IReadOnlyList<SanPham>
@{ViewData["Title"]="Quản lý bánh";bool owner=((UserSession)ViewData["AdminEmployee"]!).VaiTro==Roles.ChuTiem;}
<div class="page-heading"><div><h1>Quản lý bánh</h1><p>@Model.Count bánh trong thực đơn quản lý</p></div>@if(owner){<a admin-icon="cake" class="btn primary" href="/admin/banh/them">+ Thêm bánh</a>}</div>
<form method="get" class="toolbar"><div><label for="q">Tìm mã hoặc tên bánh</label><input id="q" name="q" type="search" value="@Context.Request.Query["q"]"/></div><button admin-icon="search" class="btn" type="submit">Tìm bánh</button></form>
<section class="panel"><div class="table-scroll"><table><thead><tr><th>Bánh</th><th>Đơn vị</th><th>Giá bán</th><th>Trạng thái</th>@if(owner){<th>Thao tác</th>}</tr></thead><tbody>
@foreach(var p in Model){<tr><td><div class="photo-name">@if(AdminDisplay.Photo(p) is {} photo){<img class="photo-thumb" src="@photo" alt="@p.TenSanPham"/>}<div><strong>@p.TenSanPham</strong><br/><small class="muted">B@(p.MaSanPham.ToString("000"))</small></div></div></td><td>@p.DonViTinh</td><td class="nowrap">@BakeryDisplay.Money(p.GiaBan)</td><td><span class="status @(p.DangKinhDoanh?"active":"inactive")">@(p.DangKinhDoanh?"Đang bán":"Ngừng bán")</span></td>@if(owner){<td><div class="actions"><a admin-icon="edit" class="btn small" href="/admin/banh/@p.MaSanPham/sua">Sửa</a><form data-confirm-title="@(p.DangKinhDoanh?"Ngừng bán "+p.TenSanPham+"?":null)" data-confirm-message="Bánh sẽ ẩn khỏi thực đơn đặt mua. Lịch sử đơn hàng và tồn kho được giữ nguyên; bạn có thể mở bán lại." data-confirm-label="Ngừng bán bánh" action="/admin/banh/@p.MaSanPham/trang-thai" method="post" asp-antiforgery="true"><input type="hidden" name="active" value="@((!p.DangKinhDoanh).ToString())"/><button admin-icon="@(p.DangKinhDoanh?"pause":"play")" class="btn small" type="submit">@(p.DangKinhDoanh?"Ngừng bán":"Mở bán")</button></form></div></td>}</tr>}
</tbody></table></div>@if(Model.Count==0){<p class="empty">Không tìm thấy bánh phù hợp.</p>}</section>
