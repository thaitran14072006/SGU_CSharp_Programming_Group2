@model AdminInventory
@{ViewData["Title"]="Kho bánh";bool owner=((UserSession)ViewData["AdminEmployee"]!).VaiTro==Roles.ChuTiem;}
<div class="page-heading"><div><h1>Kho bánh</h1><p>Tồn bán được loại trừ lô hết hạn, ngừng bán và chưa đến ngày sản xuất.</p></div>@if(owner){<a class="btn primary" href="/admin/kho/nhap">+ Nhập lô bánh</a>}</div>
<section class="panel"><h2>Tồn theo sản phẩm</h2><div class="table-scroll"><table><thead><tr><th>Bánh</th><th>Tổng tồn</th><th>Có thể bán</th><th>Hết hạn</th><th>Ngừng bán</th></tr></thead><tbody>@foreach(var s in Model.Stock){<tr><td>@s.TenSanPham</td><td>@s.TongTon</td><td><strong>@s.TonCoTheBan</strong> @s.DonViTinh</td><td>@s.TonHetHan</td><td>@s.TonNgungBan</td></tr>}</tbody></table></div></section>
<section class="panel"><h2>Lô bánh và hạn dùng</h2><div class="table-scroll"><table><thead><tr><th>Lô</th><th>Bánh</th><th>Sản xuất</th><th>Hết hạn</th><th>Còn lại</th><th>Tình trạng</th>@if(owner){<th>Thao tác</th>}</tr></thead><tbody>@foreach(var l in Model.Lots){<tr><td>#@l.MaLo</td><td>@l.TenSanPham</td><td>@l.NgaySanXuat.ToString("dd/MM/yyyy")</td><td>@l.HanSuDung.ToString("dd/MM/yyyy")</td><td>@l.SoLuongCon / @l.SoLuongNhap</td><td>@l.TrangThaiHienThi</td>@if(owner){<td><form action="/admin/kho/@l.MaLo/trang-thai" method="post" asp-antiforgery="true"><input type="hidden" name="status" value="@(l.TinhTrang==LotStatus.Selling?LotStatus.Stopped:LotStatus.Selling)"/><button class="btn small" type="submit">@(l.TinhTrang==LotStatus.Selling?"Ngừng lô":"Mở lại lô")</button></form></td>}</tr>}</tbody></table></div>@if(Model.Lots.Count==0){<p class="empty">Chưa có lô bánh.</p>}</section>
