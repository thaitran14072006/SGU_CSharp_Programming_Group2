@model AdminStaffForm
@{ViewData["Title"]=Model.Id==0?"Thêm nhân viên":"Sửa nhân viên";}
<div class="page-heading"><h1>@ViewData["Title"]</h1><a class="btn" href="/admin/nhan-vien">← Nhân viên</a></div>
<form action="/admin/nhan-vien/luu" method="post" asp-antiforgery="true" class="panel edit-panel"><div asp-validation-summary="All" class="validation" role="alert"></div><input asp-for="Id" type="hidden"/><div class="form-grid"><div><label asp-for="FullName">Họ tên *</label><input asp-for="FullName" maxlength="100" required/></div><div><label asp-for="Phone">Điện thoại *</label><input asp-for="Phone" type="tel" pattern="[0-9]{10}" maxlength="10" required/></div><div><label asp-for="Role">Chức vụ *</label><select asp-for="Role">@foreach(var role in new[]{Roles.ChuTiem,Roles.ThuNgan,Roles.Kho,Roles.NhanVien}){<option value="@role">@Roles.Display(role)</option>}</select></div><div><label asp-for="StartDate">Ngày vào làm *</label><input asp-for="StartDate" type="date" required/></div></div><label class="check"><input asp-for="Active"/> Đang làm việc</label><div class="form-actions"><button class="btn primary" type="submit">Lưu nhân viên</button><a class="btn" href="/admin/nhan-vien">Hủy</a></div></form>
