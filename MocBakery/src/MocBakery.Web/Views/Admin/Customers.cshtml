@model IReadOnlyList<KhachHang>
@{ViewData["Title"]="Khách hàng";}
<div class="page-heading"><div><h1>Khách hàng</h1><p>Hồ sơ khách dùng chung với cửa hàng.</p></div><a class="btn primary" href="/admin/khach-hang/them">+ Thêm khách hàng</a></div>
<form method="get" class="toolbar"><div><label for="q">Tên hoặc số điện thoại</label><input id="q" name="q" type="search" value="@Context.Request.Query["q"]"/></div><button class="btn" type="submit">Tìm khách</button></form>
<section class="panel"><div class="table-scroll"><table><thead><tr><th>Mã</th><th>Khách hàng</th><th>Điện thoại</th><th>Địa chỉ</th><th>Thao tác</th></tr></thead><tbody>@foreach(var c in Model){<tr><td>KH@(c.MaKhachHang.ToString("000"))</td><td>@c.HoTen</td><td>@c.SoDienThoai</td><td>@c.DiaChi</td><td><a class="btn small" href="/admin/khach-hang/@c.MaKhachHang/sua">Sửa hồ sơ</a></td></tr>}</tbody></table></div>@if(Model.Count==0){<p class="empty">Không tìm thấy khách hàng.</p>}</section>
