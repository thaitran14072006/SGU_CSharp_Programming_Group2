@model IReadOnlyList<NhanVien>
@{ViewData["Title"]="Nhân viên";}
<div class="page-heading"><div><h1>Nhân viên</h1><p>Quản lý hồ sơ và chức vụ trước khi cấp tài khoản.</p></div><a class="btn primary" href="/admin/nhan-vien/them">+ Thêm nhân viên</a></div>
<section class="panel"><div class="table-scroll"><table><thead><tr><th>Mã</th><th>Họ tên</th><th>Điện thoại</th><th>Chức vụ</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach(var s in Model){<tr><td>@s.MaHienThi</td><td>@s.HoTen</td><td>@s.SoDienThoai</td><td>@Roles.Display(s.ChucVu)</td><td><span class="status @(s.DangLam?"active":"inactive")">@(s.DangLam?"Đang làm":"Đã nghỉ")</span></td><td><a class="btn small" href="/admin/nhan-vien/@s.MaNhanVien/sua">Sửa</a></td></tr>}</tbody></table></div>@if(Model.Count==0){<p class="empty">Chưa có hồ sơ nhân viên.</p>}</section>
