@model IReadOnlyList<MocBakery.Models.DTOs.Sales.InvoiceLine>
@{var invoice=(MocBakery.Models.DTOs.Customers.InvoiceSummary)ViewData["Invoice"]!;ViewData["Title"]="Hóa đơn #"+invoice.MaHoaDon;}
<div class="page-heading"><div><h1>Hóa đơn #@invoice.MaHoaDon</h1><p>@invoice.NgayLap.ToString("dd/MM/yyyy HH:mm") · @invoice.CustomerName</p></div><a class="btn" href="/admin/hoa-don">← Hóa đơn</a></div>
<section class="panel"><div class="table-scroll"><table><thead><tr><th>Bánh</th><th>Lô xuất</th><th>Số lượng</th><th>Đơn giá</th><th>Thành tiền</th></tr></thead><tbody>@foreach(var l in Model){<tr><td>@l.Product</td><td>#@l.LotId</td><td>@l.Quantity</td><td>@BakeryDisplay.Money(l.UnitPrice)</td><td>@BakeryDisplay.Money(l.Total)</td></tr>}</tbody></table></div><dl class="info-list"><dt>Tổng tiền</dt><dd>@BakeryDisplay.Money(invoice.TongTien)</dd><dt>Cọc đã trừ</dt><dd>@BakeryDisplay.Money(invoice.TienCocTru)</dd><dt>Số tiền thu</dt><dd><strong>@BakeryDisplay.Money(invoice.SoTienThu)</strong></dd></dl></section>
