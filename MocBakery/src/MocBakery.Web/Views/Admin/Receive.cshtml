@model AdminLotForm
@{ViewData["Title"]="Nhập lô bánh";var products=(IReadOnlyList<SanPham>)ViewData["Products"]!;}
<div class="page-heading"><h1>Nhập lô bánh</h1><a class="btn" href="/admin/kho">← Kho bánh</a></div>
<form asp-action="Receive" method="post" class="panel edit-panel"><div asp-validation-summary="All" class="validation" role="alert"></div><div class="form-grid"><div class="full-row"><label asp-for="ProductId">Bánh *</label><select asp-for="ProductId" required><option value="">Chọn bánh đang kinh doanh</option>@foreach(var p in products){<option value="@p.MaSanPham">@p.TenSanPham</option>}</select></div><div><label asp-for="Quantity">Số lượng nhập *</label><input asp-for="Quantity" min="1" max="1000000" required/></div><div><label asp-for="Source">Nguồn nhập</label><input asp-for="Source" maxlength="100"/></div><div><label asp-for="Produced">Ngày sản xuất *</label><input asp-for="Produced" type="date" required/></div><div><label asp-for="Expiry">Hạn sử dụng *</label><input asp-for="Expiry" type="date" required/></div></div><div class="form-actions"><button admin-icon="box" class="btn primary" type="submit">Ghi nhận nhập lô</button><a admin-icon="close" class="btn" href="/admin/kho">Hủy</a></div></form>
