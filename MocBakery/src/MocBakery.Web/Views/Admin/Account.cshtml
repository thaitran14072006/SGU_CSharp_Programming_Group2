@model AdminAccountForm
@{ViewData["Title"]=Model.Id==0?"Cấp tài khoản nhân viên":"Quản lý tài khoản";var staff=(IReadOnlyList<NhanVien>)ViewData["Staff"]!;}
<div class="page-heading"><h1>@ViewData["Title"]</h1><a class="btn" href="/admin/tai-khoan">← Tài khoản</a></div>
<form action="/admin/tai-khoan/luu" method="post" asp-antiforgery="true" class="panel edit-panel"><div asp-validation-summary="All" class="validation" role="alert"></div><input asp-for="Id" type="hidden"/>
@if(Model.Id==0){<label asp-for="EmployeeId">Nhân viên được cấp tài khoản *</label><select asp-for="EmployeeId" required><option value="">Chọn hồ sơ đang làm, chưa có tài khoản</option>@foreach(var s in staff.Where(x=>x.DangLam&&x.MaTaiKhoan is null)){<option value="@s.MaNhanVien">@s.MaHienThi · @s.HoTen · @Roles.Display(s.ChucVu)</option>}</select><p class="muted small">Họ tên và quyền lấy từ hồ sơ nhân viên. <a href="/admin/nhan-vien/them">Thêm hồ sơ mới</a> nếu chưa có.</p>}
<label asp-for="Username">Tên đăng nhập *</label><input asp-for="Username" maxlength="50" readonly="@(Model.Id>0)" autocomplete="off" required/>
@if(Model.Id==0){<label for="Password">Mật khẩu tạm *</label><input id="Password" name="Password" type="password" autocomplete="new-password" minlength="8" maxlength="64" required/>}
else{<div class="form-grid"><div><label asp-for="FullName">Họ tên *</label><input asp-for="FullName" maxlength="100" required/></div><div><label asp-for="Role">Quyền</label><select asp-for="Role">@foreach(var role in new[]{Roles.ChuTiem,Roles.ThuNgan,Roles.Kho,Roles.NhanVien}){<option value="@role">@Roles.Display(role)</option>}</select></div></div><label class="check"><input asp-for="Active"/> Tài khoản hoạt động</label>}
<div class="form-actions"><button admin-icon="save" class="btn primary" type="submit">Lưu tài khoản</button><a admin-icon="close" class="btn" href="/admin/tai-khoan">Hủy</a></div></form>
@if(Model.Id>0){<form data-confirm-title="Đặt lại mật khẩu cho @Model.Username?" data-confirm-message="Nhân viên sẽ phải đăng nhập bằng mật khẩu tạm mới và đổi mật khẩu trước khi làm việc. Các phiên đăng nhập cũ sẽ hết hiệu lực." data-confirm-label="Đặt lại mật khẩu" action="/admin/tai-khoan/@Model.Id/mat-khau" method="post" asp-antiforgery="true" class="panel edit-panel"><h2>Đặt lại mật khẩu tạm</h2><p class="muted small">Nhân viên phải đổi mật khẩu trước khi tiếp tục làm việc. Tài khoản đang dùng đổi mật khẩu ở menu riêng.</p><label for="reset-password">Mật khẩu tạm mới</label><input id="reset-password" name="password" type="password" autocomplete="new-password" minlength="8" maxlength="64" required/><div class="form-actions"><button admin-icon="key" class="btn" type="submit">Đặt lại mật khẩu</button></div></form>}
