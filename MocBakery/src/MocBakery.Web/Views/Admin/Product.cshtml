@model AdminProductForm
@{ViewData["Title"]=Model.Id==0?"Thêm bánh":"Sửa bánh";var categories=(IReadOnlyList<LoaiBanh>)ViewData["Categories"]!;}
<div class="page-heading"><div><h1>@ViewData["Title"]</h1><p>Thông tin được cập nhật cho cả cửa hàng và trang khách.</p></div><a class="btn" href="/admin/banh">← Danh sách bánh</a></div>
<form action="/admin/banh/luu" method="post" enctype="multipart/form-data" asp-antiforgery="true" class="panel edit-panel"><div asp-validation-summary="All" class="validation" role="alert"></div><input asp-for="Id" type="hidden"/>
<div class="form-grid"><div class="full-row"><label asp-for="Name">Tên bánh *</label><input asp-for="Name" maxlength="100" required/></div><div><label asp-for="CategoryId">Danh mục *</label><select asp-for="CategoryId" required><option value="">Chọn danh mục</option>@foreach(var c in categories){<option value="@c.MaLoai">@c.TenLoai @(c.DangSuDung?"":"(ngừng dùng)")</option>}</select></div><div><label asp-for="Unit">Đơn vị *</label><select asp-for="Unit"><option>Cái</option><option>Hộp</option><option>Ổ</option></select></div>
<div><label asp-for="Price">Giá bán *</label><input asp-for="Price" type="number" min="0.01" step="0.01" required/></div><div><label asp-for="ShelfDays">Hạn dùng mặc định theo ngày</label><input asp-for="ShelfDays" type="number" min="1" max="3650"/></div><div><label asp-for="Threshold">Ngưỡng cảnh báo tồn</label><input asp-for="Threshold" type="number" min="0" step="0.01"/></div><div><label asp-for="Picture">Ảnh bánh PNG hoặc JPG tối đa 5 MB</label><input asp-for="Picture" type="file" accept="image/png,image/jpeg"/></div><div class="full-row"><label asp-for="Description">Mô tả bánh</label><textarea asp-for="Description" maxlength="500"></textarea></div></div>
<label class="check"><input asp-for="Active"/> Đang kinh doanh</label>@if(Model.Id>0){<label class="check"><input asp-for="RemovePicture"/> Bỏ ảnh đã tải lên, dùng ảnh theo loại bánh nếu có</label>}
<div class="form-actions"><button class="btn primary" type="submit">Lưu bánh</button><a class="btn" href="/admin/banh">Hủy</a></div></form>
