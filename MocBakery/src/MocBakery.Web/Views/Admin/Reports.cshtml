@model IReadOnlyList<RevenueDay>
@{ViewData["Title"]="Báo cáo doanh thu";var from=(DateTime)ViewData["From"]!;var to=(DateTime)ViewData["To"]!;var products=(IReadOnlyList<ProductSales>)ViewData["Bestsellers"]!;}
<div class="page-heading"><div><h1>Báo cáo doanh thu</h1><p>Số liệu từ hóa đơn thực tế, không cộng các yêu cầu mua chưa giao.</p></div></div>
<form method="get" class="toolbar"><div><label for="from">Từ ngày</label><input id="from" name="from" type="date" value="@from.ToString("yyyy-MM-dd")" required/></div><div><label for="to">Đến ngày</label><input id="to" name="to" type="date" value="@to.ToString("yyyy-MM-dd")" required/></div><button class="btn primary" type="submit">Xem báo cáo</button></form><div asp-validation-summary="All" class="validation" role="alert"></div>
<div class="stats"><article class="stat"><span>Doanh thu trong kỳ</span><strong>@BakeryDisplay.Money(Model.Sum(x=>x.Revenue))</strong><small>@from.ToString("dd/MM/yyyy") – @to.ToString("dd/MM/yyyy")</small></article><article class="stat"><span>Số hóa đơn</span><strong>@Model.Sum(x=>x.InvoiceCount)</strong><small>Trong khoảng ngày đã chọn</small></article></div>
<section class="panel"><h2>Theo ngày</h2><div class="table-scroll"><table><thead><tr><th>Ngày</th><th>Hóa đơn</th><th>Doanh thu</th></tr></thead><tbody>@foreach(var d in Model){<tr><td>@d.Day.ToString("dd/MM/yyyy")</td><td>@d.InvoiceCount</td><td>@BakeryDisplay.Money(d.Revenue)</td></tr>}</tbody></table></div>@if(Model.Count==0){<p class="empty">Không có hóa đơn trong kỳ.</p>}</section>
<section class="panel"><h2>Bánh bán chạy</h2><div class="table-scroll"><table><thead><tr><th>Bánh</th><th>Số lượng đã bán</th><th>Doanh thu</th></tr></thead><tbody>@foreach(var p in products){<tr><td>@p.Name</td><td>@p.Quantity</td><td>@BakeryDisplay.Money(p.Revenue)</td></tr>}</tbody></table></div></section>
