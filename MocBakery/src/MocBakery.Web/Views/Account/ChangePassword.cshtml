@model PasswordForm
@{ ViewData["Title"] = "Đổi mật khẩu"; }
<section class="card" aria-labelledby="title">
    <p class="eyebrow">BẢO VỆ TÀI KHOẢN</p>
    <h1 id="title">Đổi mật khẩu</h1>
    <p class="intro">Mật khẩu mới phải có 8–64 ký tự và khác mật khẩu hiện tại. Sau khi đổi, bạn cần đăng nhập lại.</p>
    <form asp-action="ChangePassword" method="post">
        <div asp-validation-summary="All" class="validation" role="alert"></div>
        <label for="OldPassword">Mật khẩu hiện tại *</label>
        <input id="OldPassword" name="OldPassword" type="password" autocomplete="current-password" maxlength="64" required />
        <span asp-validation-for="OldPassword"></span>
        <label for="Password">Mật khẩu mới *</label>
        <input id="Password" name="Password" type="password" autocomplete="new-password" minlength="8" maxlength="64" required />
        <span asp-validation-for="Password"></span>
        <label for="Confirmation">Xác nhận mật khẩu mới *</label>
        <input id="Confirmation" name="Confirmation" type="password" autocomplete="new-password" minlength="8" maxlength="64" required />
        <span asp-validation-for="Confirmation"></span>
        <button class="primary" type="submit">Lưu mật khẩu mới</button>
        <a class="secondary" asp-action="Index">Hủy và quay lại</a>
    </form>
</section>
